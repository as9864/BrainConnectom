# Copy this file to .env and fill in your own token to enable the real
# hemibrain fetch in flyhash_experiment (optional - a synthetic fallback is
# used automatically if this is left empty).
#
# How to get a free token:
#   1. Go to https://neuprint.janelia.org and sign in with a Google account.
#   2. Click your account icon (top right) -> "Account".
#   3. Copy the "Auth Token" value and paste it below.
NEUPRINT_TOKEN=
